# Products API base URL (server-only). DummyJSON catalogue for this take-home.
# Optional locally — defaults to https://dummyjson.com when unset.
PRODUCTS_API_URL=https://dummyjson.com

# Canonical public origin for metadata, Open Graph, sitemap.xml, and robots.txt.
# No trailing slash. Local default is fine for development.
# Production / Vercel: MUST be set to the real deployment origin, e.g.
#   NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
